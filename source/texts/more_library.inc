TEXT(sg_help,
     .en = "On the page of a game, an orange line says so when no sigpatches are found on the SD card. The game installs all the same: it is only a warning.",
     .es = "En la página de un juego, una línea naranja lo dice cuando no se encuentran sigpatches en la tarjeta SD. El juego se instala igualmente: solo es un aviso.",
     .fr = "Sur la page d'un jeu, une ligne orange le signale quand aucun sigpatch n'est trouvé sur la carte SD. Le jeu s'installe quand même : ce n'est qu'un avertissement.",
     .de = "Auf der Seite eines Spiels weist eine orange Zeile darauf hin, wenn auf der SD-Karte keine Sigpatches gefunden werden. Das Spiel wird trotzdem installiert: Es ist nur ein Hinweis.",
     .it = "Nella pagina di un gioco, una riga arancione lo segnala quando sulla scheda SD non si trovano sigpatch. Il gioco si installa comunque: è solo un avviso.",
     .pt = "Na página de um jogo, uma linha laranja avisa quando não se encontram sigpatches no cartão SD. O jogo instala-se na mesma: é só um aviso.",
     .nl = "Op de pagina van een game meldt een oranje regel het als er geen sigpatches op de SD-kaart staan. De game wordt toch geïnstalleerd: het is alleen een waarschuwing.",
     .ru = "На странице игры оранжевая строка сообщает, если на SD-карте не найдены sigpatches. Игра всё равно установится: это только предупреждение.",
     .ja = "SD カードに sigpatches が見つからないと、ゲームのページにオレンジの行で表示します。インストールはそのまま行えます。警告だけです。",
     .ko = "SD 카드에서 sigpatches를 찾지 못하면 게임 페이지에 주황색 줄로 알려 줍니다. 게임은 그대로 설치됩니다. 경고일 뿐입니다.",
     .zh = "在 SD 卡上找不到 sigpatches 时，游戏页面会显示一行橙色提示。游戏照样可以安装：这只是提醒。")
