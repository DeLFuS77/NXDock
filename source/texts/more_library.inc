TEXT(sg_line,
     .en = "No sigpatches found: the game will install, but it will not start without them.",
     .es = "No se encuentran sigpatches: el juego se instalará, pero sin ellos no arrancará.",
     .fr = "Sigpatches introuvables : le jeu s'installera, mais ne démarrera pas sans eux.",
     .de = "Keine Sigpatches gefunden: Das Spiel wird installiert, startet aber ohne sie nicht.",
     .it = "Nessuna sigpatch trovata: il gioco si installerà, ma senza di esse non partirà.",
     .pt = "Não se encontram sigpatches: o jogo instala-se, mas sem eles não arranca.",
     .nl = "Geen sigpatches gevonden: de game wordt geïnstalleerd, maar start niet zonder.",
     .ru = "Sigpatches не найдены: игра установится, но без них не запустится.",
     .ja = "sigpatches が見つかりません。ゲームはインストールされますが、sigpatches がないと起動しません。",
     .ko = "sigpatches를 찾을 수 없습니다. 게임은 설치되지만 sigpatches 없이는 시작되지 않습니다.",
     .zh = "未找到 sigpatches：游戏可以安装，但没有它们将无法启动。")
