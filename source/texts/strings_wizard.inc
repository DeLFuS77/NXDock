TEXT(wiz_saver_body,
     .en = "With saver mode, while installing and with nothing touched for a minute, the screen goes dark. Any button or a touch lights it again.",
     .es = "Con el modo ahorro, mientras instala y sin tocar nada durante un minuto, la pantalla se oscurece. Cualquier botón o el dedo la vuelven a encender.",
     .fr = "En mode économie, pendant une installation et sans rien toucher pendant une minute, l'écran s'assombrit. Un bouton ou un toucher le rallume.",
     .de = "Im Sparmodus wird der Bildschirm beim Installieren dunkel, wenn eine Minute nichts berührt wird. Jede Taste oder eine Berührung macht ihn wieder hell.",
     .it = "Con la modalità risparmio, durante l'installazione e senza toccare nulla per un minuto, lo schermo si scurisce. Qualsiasi pulsante o un tocco lo riaccende.",
     .pt = "Com o modo poupança, durante a instalação e sem tocar em nada durante um minuto, o ecrã escurece. Qualquer botão ou um toque volta a acendê-lo.",
     .nl = "Met de spaarstand wordt het scherm tijdens het installeren donker als er een minuut niets wordt aangeraakt. Elke knop of een aanraking maakt het weer licht.",
