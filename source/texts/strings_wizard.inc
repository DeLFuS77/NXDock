TEXT(wiz_share_q,
     .en = "Share what is installed with your library? It will know which games, updates and DLC this console has, and where.",
     .es = "¿Compartir lo instalado con tu biblioteca? Sabrá qué juegos, actualizaciones y DLC tiene esta consola, y dónde.",
