TEXT(wiz_connect_body,
     .en = "The usual pairing: NXDock looks for the app on your network and gives you a code to approve in the app.",
     .es = "El emparejamiento de siempre: NXDock busca la app en tu red y te da un código para aprobarlo en la app.",
     .fr = "L'appairage habituel : NXDock cherche l'app sur votre réseau et vous donne un code à approuver dans l'app.",
     .de = "Das übliche Koppeln: NXDock sucht die App in deinem Netzwerk und gibt dir einen Code, den du in der App bestätigst.",
     .it = "Il solito abbinamento: NXDock cerca l'app nella tua rete e ti dà un codice da approvare nell'app.",
     .pt = "O emparelhamento de sempre: o NXDock procura a app na tua rede e dá-te um código para aprovares na app.",
     .nl = "Het gewone koppelen: NXDock zoekt de app op je netwerk en geeft je een code om in de app goed te keuren.",
     .ru = "Обычное сопряжение: NXDock ищет приложение в вашей сети и даёт код, который нужно подтвердить в приложении.",
     .ja = "いつものペアリングです。NXDock がネットワーク上のアプリを探し、アプリで承認するコードを表示します。",
     .ko = "평소의 페어링입니다. NXDock이 네트워크에서 앱을 찾고, 앱에서 승인할 코드를 보여 줍니다.",
     .zh = "和平常一样配对：NXDock 在你的网络中寻找应用，并给出一个要在应用中批准的代码。")
