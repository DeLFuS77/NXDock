TEXT(risk_body,
     .en = "Installing your own copies like this can get the console banned. Recommended: an emuMMC with no access to Nintendo (90DNS or the DNS block of Atmosphère). This is said once per session.",
     .es = "Instalar tus copias así puede acabar en un baneo de la consola. Lo recomendado: un emuMMC sin acceso a Nintendo (90DNS o el bloqueo de DNS de Atmosphère). Se avisa una vez por sesión.",
     .fr = "Installer vos copies ainsi peut faire bannir la console. Recommandé : un emuMMC sans accès à Nintendo (90DNS ou le blocage DNS d'Atmosphère). Ce message apparaît une fois par session.",
     .de = "Eigene Kopien so zu installieren kann zu einem Bann der Konsole führen. Empfohlen: ein emuMMC ohne Zugang zu Nintendo (90DNS oder die DNS-Sperre von Atmosphère). Der Hinweis kommt einmal pro Sitzung.",
     .it = "Installare le tue copie così può far bannare la console. Consigliato: un emuMMC senza accesso a Nintendo (90DNS o il blocco DNS di Atmosphère). L'avviso compare una volta per sessione.",
     .pt = "Instalar as tuas cópias assim pode levar a um banimento da consola. Recomendado: um emuMMC sem acesso à Nintendo (90DNS ou o bloqueio de DNS do Atmosphère). O aviso aparece uma vez por sessão.",
     .nl = "Je eigen kopieën zo installeren kan de console een ban opleveren. Aanbevolen: een emuMMC zonder toegang tot Nintendo (90DNS of de DNS-blokkade van Atmosphère). Dit wordt één keer per sessie gezegd.",
     .ru = "Такая установка своих копий может привести к бану консоли. Рекомендуется emuMMC без доступа к Nintendo (90DNS или DNS-блокировка Atmosphère). Предупреждение показывается раз за сеанс.",
