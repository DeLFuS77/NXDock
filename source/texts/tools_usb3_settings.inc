TEXT(h_updates,
     .en = "When NXDock opens, a notice says how many updates your library has for what is installed. The + menu of the library installs them.",
     .es = "Al abrir NXDock, un aviso dice cuántas actualizaciones tiene tu biblioteca para lo instalado. El menú + de la biblioteca las instala.",
     .fr = "À l'ouverture de NXDock, un avis dit combien de mises à jour votre bibliothèque a pour ce qui est installé. Le menu + de la bibliothèque les installe.",
     .de = "Beim Öffnen von NXDock sagt ein Hinweis, wie viele Updates deine Bibliothek für das Installierte hat. Das +-Menü der Bibliothek installiert sie.",
     .it = "All'apertura di NXDock, un avviso dice quanti aggiornamenti ha la tua libreria per ciò che è installato. Il menu + della libreria li installa.",
     .pt = "Ao abrir o NXDock, um aviso diz quantas atualizações a sua biblioteca tem para o que está instalado. O menu + da biblioteca instala-as.",
     .nl = "Bij het openen van NXDock zegt een melding hoeveel updates je bibliotheek heeft voor wat geïnstalleerd is. Het +-menu van de bibliotheek installeert ze.",
     .ru = "При запуске NXDock уведомление говорит, сколько обновлений есть в вашей библиотеке для установленного. Меню + библиотеки их устанавливает.",
     .ja = "NXDock を開くと、インストール済みのものに対してライブラリにある更新の数をお知らせします。ライブラリの + メニューでインストールできます。",
     .ko = "NXDock을 열면, 설치된 것에 대해 라이브러리에 있는 업데이트 수를 알려 줍니다. 라이브러리의 + 메뉴로 설치합니다.",
     .zh = "打开 NXDock 时，提示你的库里有多少已安装内容的更新。库的 + 菜单可以安装它们。")
TEXT(h_versions,
     .en = "In the console says which updates and DLC are missing for games that are not in your library, from the list of titledb (downloaded at most once a day). It only tells.",
     .es = "En la consola dice qué actualizaciones y DLC faltan a los juegos que no están en tu biblioteca, con la lista de titledb (se descarga como mucho una vez al día). Solo lo dice.",
     .fr = "Sur la console indique les mises à jour et DLC qui manquent aux jeux absents de votre bibliothèque, d'après la liste de titledb (téléchargée au plus une fois par jour). Il ne fait que le dire.",
     .de = "Auf der Konsole zeigt, welche Updates und DLC Spielen fehlen, die nicht in deiner Bibliothek sind, nach der Liste von titledb (höchstens einmal am Tag geladen). Es sagt es nur.",
     .it = "Sulla console indica quali aggiornamenti e DLC mancano ai giochi che non sono nella tua libreria, dalla lista di titledb (scaricata al massimo una volta al giorno). Lo dice soltanto.",
     .pt = "Na consola diz que atualizações e DLC faltam aos jogos que não estão na sua biblioteca, pela lista do titledb (descarregada no máximo uma vez por dia). Só o diz.",
     .nl = "Op de console laat zien welke updates en DLC ontbreken bij games die niet in je bibliotheek staan, volgens de lijst van titledb (hoogstens eens per dag gedownload). Het zegt het alleen.",
     .ru = "На консоли показывает, каких обновлений и DLC не хватает играм, которых нет в вашей библиотеке, по списку titledb (загружается не чаще раза в день). Только сообщает.",
     .ja = "「本体」で、ライブラリにないゲームに足りない更新と DLC を titledb のリスト (多くても 1 日 1 回ダウンロード) から表示します。表示するだけです。",
     .ko = "본체에서 라이브러리에 없는 게임에 빠진 업데이트와 DLC를 titledb 목록 (하루에 많아야 한 번 다운로드)으로 보여 줍니다. 알려 주기만 합니다.",
     .zh = "在“主机上”中，根据 titledb 列表（每天最多下载一次）显示不在你库中的游戏缺少哪些更新和 DLC。只是提示。")
TEXT(h_dest,
     .en = "Where the page of a game installs: the SD card, or asking each time. The internal memory is always asked first, every time.",
     .es = "Dónde instala la ficha de un juego: la tarjeta SD, o preguntar cada vez. La memoria interna siempre pregunta antes, cada vez.",
     .fr = "Où installe la page d'un jeu : la carte SD, ou demander à chaque fois. La mémoire interne est toujours demandée avant, à chaque fois.",
     .de = "Wohin die Seite eines Spiels installiert: auf die SD-Karte, oder jedes Mal fragen. Der interne Speicher wird immer vorher gefragt, jedes Mal.",
     .it = "Dove installa la pagina di un gioco: la scheda SD, o chiedere ogni volta. La memoria interna chiede sempre prima, ogni volta.",
     .pt = "Onde instala a página de um jogo: o cartão SD, ou perguntar sempre. A memória interna pergunta sempre antes, de cada vez.",
     .nl = "Waar de pagina van een game installeert: op de SD-kaart, of elke keer vragen. Het interne geheugen wordt altijd eerst gevraagd, elke keer.",
     .ru = "Куда устанавливает страница игры: на SD-карту или спрашивать каждый раз. Внутренняя память всегда спрашивается заранее, каждый раз.",
     .ja = "ゲームのページのインストール先: SD カード、または毎回たずねる。本体保存メモリーは毎回、必ず先にたずねます。",
     .ko = "게임 페이지의 설치 위치: SD 카드, 또는 매번 묻기. 본체 저장 메모리는 매번 반드시 먼저 묻습니다.",
     .zh = "游戏页面安装到哪里：SD 卡，或每次询问。主机内存每次都会先询问。")
TEXT(h_pick,
     .en = "What is ticked when you open a game: what is missing, the game only, or the game and its update.",
     .es = "Lo que sale marcado al abrir un juego: lo que falta, solo el juego, o el juego y su actualización.",
     .fr = "Ce qui est coché à l'ouverture d'un jeu : ce qui manque, le jeu seul, ou le jeu et sa mise à jour.",
     .de = "Was beim Öffnen eines Spiels markiert ist: was fehlt, nur das Spiel, oder das Spiel und sein Update.",
     .it = "Cosa è segnato quando apri un gioco: ciò che manca, solo il gioco, o il gioco e il suo aggiornamento.",
     .pt = "O que fica marcado ao abrir um jogo: o que falta, só o jogo, ou o jogo e a sua atualização.",
     .nl = "Wat aangevinkt is als je een game opent: wat ontbreekt, alleen de game, of de game en zijn update.",
     .ru = "Что отмечено при открытии игры: чего не хватает, только игра или игра с обновлением.",
     .ja = "ゲームを開いたときにチェックされるもの: 足りないもの、ゲームのみ、またはゲームと更新。",
     .ko = "게임을 열 때 체크되는 것: 빠진 것, 게임만, 또는 게임과 업데이트.",
     .zh = "打开游戏时勾选的内容：缺少的、仅游戏，或游戏及其更新。")
TEXT(h_save_copy,
     .en = "Before an update, a repair, going back or deleting a game, its saves are copied to the library, or to the SD card when none is linked. The console's and BCAT saves too.",
     .es = "Antes de actualizar, reparar, volver atrás o borrar un juego, sus partidas se copian a la biblioteca, o a la tarjeta SD si no hay biblioteca. También las de la consola y BCAT.",
     .fr = "Avant une mise à jour, une réparation, un retour en arrière ou la suppression d'un jeu, ses sauvegardes sont copiées dans la bibliothèque, ou sur la carte SD sans bibliothèque. Celles de la console et BCAT aussi.",
     .de = "Vor einem Update, einer Reparatur, dem Zurückgehen oder dem Löschen eines Spiels werden seine Spielstände in die Bibliothek kopiert, ohne Bibliothek auf die SD-Karte. Auch die der Konsole und BCAT.",
     .it = "Prima di aggiornare, riparare, tornare indietro o eliminare un gioco, i suoi salvataggi si copiano nella libreria, o sulla scheda SD senza libreria. Anche quelli della console e BCAT.",
     .pt = "Antes de atualizar, reparar, voltar atrás ou apagar um jogo, os seus jogos guardados são copiados para a biblioteca, ou para o cartão SD sem biblioteca. Também os da consola e BCAT.",
     .nl = "Voor een update, een reparatie, teruggaan of het verwijderen van een game worden zijn opslagbestanden naar de bibliotheek gekopieerd, of naar de SD-kaart zonder bibliotheek. Die van de console en BCAT ook.",
     .ru = "Перед обновлением, починкой, откатом или удалением игры её сохранения копируются в библиотеку, а без библиотеки — на SD-карту. Также сохранения консоли и BCAT.",
     .ja = "ゲームの更新・修復・バージョンを戻す・削除の前に、セーブデータをライブラリへ、ライブラリがなければ SD カードへコピーします。本体と BCAT のセーブデータも含みます。",
     .ko = "게임을 업데이트·복구·되돌리기·삭제하기 전에 세이브를 라이브러리로, 라이브러리가 없으면 SD 카드로 복사합니다. 본체와 BCAT 세이브도 포함합니다.",
     .zh = "在更新、修复、回退或删除游戏之前，把它的存档复制到库里，没有库时复制到 SD 卡。主机存档和 BCAT 存档也一样。")
TEXT(h_save_auto,
     .en = "Every so many days, when NXDock opens, a copy of the saves of every user without asking. To the library, or to the SD card when none is linked.",
     .es = "Cada tantos días, al abrir NXDock, una copia de las partidas de todos los usuarios sin pedirla. A la biblioteca, o a la tarjeta SD si no hay biblioteca.",
     .fr = "Tous les tant de jours, à l'ouverture de NXDock, une copie des sauvegardes de chaque utilisateur sans rien demander. Dans la bibliothèque, ou sur la carte SD sans bibliothèque.",
     .de = "Alle paar Tage, beim Öffnen von NXDock, eine Kopie der Spielstände aller Benutzer, ohne zu fragen. In die Bibliothek, ohne Bibliothek auf die SD-Karte.",
     .it = "Ogni tot giorni, all'apertura di NXDock, una copia dei salvataggi di tutti gli utenti senza chiedere. Nella libreria, o sulla scheda SD senza libreria.",
     .pt = "De tantos em tantos dias, ao abrir o NXDock, uma cópia dos jogos guardados de todos os utilizadores sem pedir. Para a biblioteca, ou para o cartão SD sem biblioteca.",
     .nl = "Om de zoveel dagen, bij het openen van NXDock, een kopie van de opslagbestanden van alle gebruikers zonder te vragen. Naar de bibliotheek, of naar de SD-kaart zonder bibliotheek.",
     .ru = "Раз в несколько дней, при запуске NXDock, копия сохранений всех пользователей без вопросов. В библиотеку, а без библиотеки — на SD-карту.",
     .ja = "数日ごとに、NXDock を開いたとき、全ユーザーのセーブデータを確認なしでコピーします。ライブラリへ、ライブラリがなければ SD カードへ。",
     .ko = "며칠마다 NXDock을 열 때 모든 사용자의 세이브를 묻지 않고 복사합니다. 라이브러리로, 라이브러리가 없으면 SD 카드로.",
     .zh = "每隔几天，打开 NXDock 时，不询问就复制所有用户的存档。复制到库里，没有库时复制到 SD 卡。")
TEXT(h_screen,
     .en = "Dim: while installing, after a minute without touching anything, the screen goes dark. Off in long queues: it turns off too when a queue of 2 GB or more starts. Any button or a touch lights it again.",
     .es = "Atenuada: mientras instala, tras un minuto sin tocar nada, la pantalla se oscurece. Apagada en colas largas: además se apaga al empezar una cola de 2 GB o más. Cualquier botón o el dedo la vuelven a encender.",
     .fr = "Atténué : pendant l'installation, après une minute sans rien toucher, l'écran s'assombrit. Éteint pour les longues files : il s'éteint aussi au début d'une file de 2 Go ou plus. Un bouton ou un toucher le rallume.",
     .de = "Gedimmt: beim Installieren wird der Bildschirm nach einer Minute ohne Eingabe dunkel. Aus bei langen Warteschlangen: er geht auch aus, wenn eine Warteschlange ab 2 GB startet. Jede Taste oder Berührung schaltet ihn wieder an.",
     .it = "Attenuato: durante l'installazione, dopo un minuto senza toccare nulla, lo schermo si scurisce. Spento nelle code lunghe: si spegne anche all'avvio di una coda da 2 GB o più. Un tasto o un tocco lo riaccendono.",
     .pt = "Escurecido: a instalar, após um minuto sem tocar em nada, o ecrã escurece. Desligado em filas longas: também se desliga ao começar uma fila de 2 GB ou mais. Qualquer botão ou um toque voltam a acendê-lo.",
     .nl = "Gedimd: tijdens het installeren wordt het scherm na een minuut zonder aanraken donker. Uit bij lange wachtrijen: het gaat ook uit als een wachtrij van 2 GB of meer begint. Elke knop of aanraking zet het weer aan.",
     .ru = "Затемнение: во время установки, через минуту без касаний, экран темнеет. Выкл. для длинных очередей: он ещё и выключается, когда начинается очередь от 2 ГБ. Любая кнопка или касание включают его снова.",
     .ja = "暗くする: インストール中に 1 分間操作がないと画面が暗くなります。長いキューでオフ: 2 GB 以上のキューが始まると画面もオフになります。ボタンかタッチで再び点きます。",
     .ko = "어둡게: 설치 중 1분 동안 아무것도 만지지 않으면 화면이 어두워집니다. 긴 대기열에서 끄기: 2 GB 이상의 대기열이 시작되면 화면도 꺼집니다. 버튼이나 터치로 다시 켜집니다.",
     .zh = "变暗：安装时一分钟不操作，屏幕变暗。长队列时关闭：开始 2 GB 以上的队列时屏幕也会关闭。任意按键或触摸都会重新点亮。")
TEXT(h_finish,
     .en = "When the queue ends: a notice, a soft glow, two short vibrations and a sound (when Sounds is on).",
     .es = "Al acabar la cola: un aviso, un brillo suave, dos vibraciones cortas y un sonido (con los sonidos activados).",
     .fr = "À la fin de la file : un avis, une lueur douce, deux courtes vibrations et un son (si les sons sont activés).",
     .de = "Wenn die Warteschlange fertig ist: ein Hinweis, ein sanftes Leuchten, zwei kurze Vibrationen und ein Ton (wenn die Töne an sind).",
     .it = "Alla fine della coda: un avviso, un bagliore leggero, due brevi vibrazioni e un suono (con i suoni attivi).",
     .pt = "Ao acabar a fila: um aviso, um brilho suave, duas vibrações curtas e um som (com os sons ligados).",
     .nl = "Als de wachtrij klaar is: een melding, een zachte gloed, twee korte trillingen en een geluid (als de geluiden aan staan).",
     .ru = "Когда очередь закончилась: уведомление, мягкое свечение, две короткие вибрации и звук (если звуки включены).",
     .ja = "キューが終わると: お知らせ、やわらかな光、短い振動 2 回、音 (サウンドがオンのとき)。",
     .ko = "대기열이 끝나면: 알림, 부드러운 빛, 짧은 진동 두 번, 소리 (소리가 켜져 있을 때).",
     .zh = "队列结束时：提示、柔和的光、两次短振动和声音（声音开启时）。")
TEXT(h_battery,
     .en = "Before installing with little battery and no charger, a notice says so; the install is not stopped. Choose from which level.",
     .es = "Antes de instalar con poca batería y sin cargador, un aviso lo dice; la instalación no se para. Elige desde qué nivel.",
     .fr = "Avant d'installer avec peu de batterie et sans chargeur, un avis le dit ; l'installation n'est pas arrêtée. Choisissez à partir de quel niveau.",
     .de = "Vor dem Installieren mit wenig Akku und ohne Ladegerät sagt es ein Hinweis; die Installation wird nicht gestoppt. Wähle, ab welchem Stand.",
     .it = "Prima di installare con poca batteria e senza caricatore, un avviso lo dice; l'installazione non si ferma. Scegli da che livello.",
     .pt = "Antes de instalar com pouca bateria e sem carregador, um aviso di-lo; a instalação não para. Escolha a partir de que nível.",
     .nl = "Voor het installeren met weinig batterij en zonder lader zegt een melding het; de installatie stopt niet. Kies vanaf welk niveau.",
     .ru = "Перед установкой при низком заряде и без зарядки появляется уведомление; установка не останавливается. Выберите, с какого уровня.",
     .ja = "バッテリーが少なく充電器がないときは、インストール前にお知らせします。インストールは止まりません。何 % からかを選べます。",
     .ko = "배터리가 적고 충전기가 없으면 설치 전에 알려 줍니다. 설치는 멈추지 않습니다. 몇 %부터인지 고르세요.",
     .zh = "电量低且未充电时，安装前会提示；安装不会停止。选择从多少电量开始提示。")
TEXT(h_notify,
     .en = "When the queue ends, your library app sends a message to your phone. It needs the library linked.",
     .es = "Al acabar la cola, la app de tu biblioteca manda un aviso al móvil. Necesita la biblioteca enlazada.",
     .fr = "À la fin de la file, l'app de votre bibliothèque envoie un message à votre téléphone. Il faut la bibliothèque liée.",
     .de = "Wenn die Warteschlange fertig ist, schickt die App deiner Bibliothek eine Nachricht an dein Handy. Dafür muss die Bibliothek verbunden sein.",
     .it = "Alla fine della coda, l'app della tua libreria manda un messaggio al telefono. Serve la libreria collegata.",
     .pt = "Ao acabar a fila, a app da sua biblioteca manda uma mensagem ao telemóvel. Precisa da biblioteca ligada.",
     .nl = "Als de wachtrij klaar is, stuurt de app van je bibliotheek een bericht naar je telefoon. De bibliotheek moet gekoppeld zijn.",
     .ru = "Когда очередь закончилась, приложение вашей библиотеки отправляет сообщение на телефон. Нужна подключённая библиотека.",
     .ja = "キューが終わると、ライブラリのアプリがスマートフォンにメッセージを送ります。ライブラリとの連携が必要です。",
     .ko = "대기열이 끝나면 라이브러리 앱이 휴대폰으로 메시지를 보냅니다. 라이브러리 연결이 필요합니다.",
     .zh = "队列结束时，你的库应用会给手机发消息。需要已连接库。")
TEXT(h_language,
     .en = "The language of NXDock: the console's, or any other it speaks.",
     .es = "El idioma de NXDock: el de la consola, o cualquier otro que hable.",
     .fr = "La langue de NXDock : celle de la console, ou toute autre qu'il parle.",
     .de = "Die Sprache von NXDock: die der Konsole, oder jede andere, die es spricht.",
     .it = "La lingua di NXDock: quella della console, o qualsiasi altra che parla.",
     .pt = "O idioma do NXDock: o da consola, ou qualquer outro que fale.",
     .nl = "De taal van NXDock: die van de console, of elke andere die het spreekt.",
     .ru = "Язык NXDock: язык консоли или любой другой, на котором он говорит.",
     .ja = "NXDock の言語: 本体の言語、または対応する他の言語。",
     .ko = "NXDock의 언어: 본체 언어, 또는 지원하는 다른 언어.",
     .zh = "NXDock 的语言：主机的语言，或它支持的其他语言。")
TEXT(h_theme,
     .en = "Light, dark, or as the console's theme.",
     .es = "Claro, oscuro, o como el tema de la consola.",
     .fr = "Clair, sombre, ou comme le thème de la console.",
     .de = "Hell, dunkel, oder wie das Design der Konsole.",
     .it = "Chiaro, scuro, o come il tema della console.",
     .pt = "Claro, escuro, ou como o tema da consola.",
     .nl = "Licht, donker, of zoals het thema van de console.",
     .ru = "Светлая, тёмная или как тема консоли.",
     .ja = "ライト、ダーク、または本体のテーマに合わせる。",
     .ko = "라이트, 다크, 또는 본체 테마를 따름.",
     .zh = "浅色、深色，或跟随主机主题。")
TEXT(h_sounds,
     .en = "The soft sounds of moving and choosing, and the one at the end of the queue.",
     .es = "Los sonidos suaves al moverse y elegir, y el del final de la cola.",
     .fr = "Les sons doux pour se déplacer et choisir, et celui de la fin de la file.",
     .de = "Die leisen Töne beim Bewegen und Wählen, und der am Ende der Warteschlange.",
     .it = "I suoni leggeri al muoversi e scegliere, e quello alla fine della coda.",
     .pt = "Os sons suaves ao mover e escolher, e o do fim da fila.",
     .nl = "De zachte geluiden bij bewegen en kiezen, en het geluid aan het eind van de wachtrij.",
     .ru = "Тихие звуки при перемещении и выборе и звук в конце очереди.",
     .ja = "移動や選択のやさしい音と、キューの終わりの音。",
     .ko = "이동하고 고를 때의 부드러운 소리와 대기열이 끝날 때의 소리.",
     .zh = "移动和选择时的轻柔声音，以及队列结束时的声音。")
TEXT(h_anim,
     .en = "Full, gentle or none: how much moves on screen. With none, everything appears at once.",
     .es = "Completas, suaves o ninguna: cuánto se mueve en pantalla. Con ninguna, todo aparece de golpe.",
     .fr = "Complètes, douces ou aucune : ce qui bouge à l'écran. Avec aucune, tout apparaît d'un coup.",
     .de = "Voll, sanft oder keine: wie viel sich auf dem Bildschirm bewegt. Mit keine erscheint alles sofort.",
     .it = "Complete, leggere o nessuna: quanto si muove sullo schermo. Con nessuna, tutto appare subito.",
     .pt = "Completas, suaves ou nenhuma: quanto se mexe no ecrã. Com nenhuma, tudo aparece de uma vez.",
     .nl = "Volledig, zacht of geen: hoeveel er beweegt op het scherm. Met geen verschijnt alles meteen.",
     .ru = "Полные, мягкие или никаких: сколько движется на экране. Без анимаций всё появляется сразу.",
     .ja = "フル、ひかえめ、なし: 画面で動く量。なしにするとすべてすぐに表示されます。",
     .ko = "전체, 부드럽게, 없음: 화면에서 움직이는 정도. 없음이면 모두 바로 나타납니다.",
     .zh = "完整、柔和或无：屏幕上动多少。选“无”时一切立即出现。")
TEXT(h_focus_view,
     .en = "Where the library shows the game in focus: in a band under the covers, or in a panel on the right.",
     .es = "Dónde enseña la biblioteca el juego enfocado: en una franja bajo las carátulas, o en un panel a la derecha.",
     .fr = "Où la bibliothèque montre le jeu sélectionné : dans une bande sous les jaquettes, ou dans un panneau à droite.",
     .de = "Wo die Bibliothek das gewählte Spiel zeigt: in einem Band unter den Covern, oder in einem Feld rechts.",
     .it = "Dove la libreria mostra il gioco selezionato: in una fascia sotto le copertine, o in un pannello a destra.",
     .pt = "Onde a biblioteca mostra o jogo selecionado: numa faixa sob as capas, ou num painel à direita.",
     .nl = "Waar de bibliotheek de gekozen game toont: in een band onder de covers, of in een paneel rechts.",
     .ru = "Где библиотека показывает выбранную игру: в полосе под обложками или в панели справа.",
     .ja = "ライブラリで選択中のゲームを表示する場所: カバーの下の帯、または右のパネル。",
     .ko = "라이브러리에서 선택한 게임을 보여 주는 곳: 표지 아래 띠, 또는 오른쪽 패널.",
     .zh = "库中选中游戏的显示位置：封面下方的横条，或右侧的面板。")
TEXT(h_touch_rumble,
     .en = "A very short vibration when a touch does something.",
     .es = "Una vibración muy corta cuando un toque hace algo.",
     .fr = "Une vibration très courte quand un toucher fait quelque chose.",
     .de = "Eine sehr kurze Vibration, wenn eine Berührung etwas tut.",
     .it = "Una vibrazione brevissima quando un tocco fa qualcosa.",
     .pt = "Uma vibração muito curta quando um toque faz algo.",
     .nl = "Een heel korte trilling als een aanraking iets doet.",
     .ru = "Очень короткая вибрация, когда касание что-то делает.",
     .ja = "タッチで何かが起きたときのごく短い振動。",
     .ko = "터치로 무언가 할 때 아주 짧은 진동.",
     .zh = "触摸执行操作时非常短的振动。")
TEXT(h_wizard,
     .en = "Opens the first-run wizard again, to go through its choices one by one.",
     .es = "Abre otra vez el asistente del principio, para repasar sus opciones una a una.",
     .fr = "Rouvre l'assistant du premier lancement, pour revoir ses choix un par un.",
     .de = "Öffnet den Assistenten vom ersten Start wieder, um seine Fragen nacheinander durchzugehen.",
     .it = "Riapre la procedura iniziale, per rivedere le sue scelte una per una.",
     .pt = "Abre de novo o assistente do início, para rever as suas escolhas uma a uma.",
     .nl = "Opent de wizard van de eerste start opnieuw, om zijn keuzes één voor één door te lopen.",
     .ru = "Снова открывает мастер первого запуска, чтобы пройти его выбор по одному.",
     .ja = "初回のウィザードをもう一度開き、選択を順に見直します。",
     .ko = "처음 실행 마법사를 다시 열어 선택을 하나씩 다시 봅니다.",
     .zh = "再次打开首次运行向导，逐一查看它的选项。")
TEXT(h_self_update,
     .en = "Looks for a new version of NXDock. Its signature is checked before it takes the place of this one.",
     .es = "Busca una versión nueva de NXDock. Se comprueba su firma antes de que ocupe el lugar de esta.",
     .fr = "Cherche une nouvelle version de NXDock. Sa signature est vérifiée avant qu'elle ne remplace celle-ci.",
     .de = "Sucht eine neue Version von NXDock. Ihre Signatur wird geprüft, bevor sie diese ersetzt.",
     .it = "Cerca una nuova versione di NXDock. La sua firma viene controllata prima che prenda il posto di questa.",
     .pt = "Procura uma versão nova do NXDock. A sua assinatura é verificada antes de ocupar o lugar desta.",
     .nl = "Zoekt een nieuwe versie van NXDock. De handtekening wordt gecontroleerd voordat die deze vervangt.",
     .ru = "Ищет новую версию NXDock. Её подпись проверяется, прежде чем она заменит эту.",
     .ja = "NXDock の新しいバージョンを探します。今のものと置き換える前に署名を確認します。",
     .ko = "NXDock의 새 버전을 찾습니다. 지금 버전을 바꾸기 전에 서명을 확인합니다.",
     .zh = "查找 NXDock 的新版本。在替换当前版本前会先校验签名。")
TEXT(h_self_notice,
     .en = "When NXDock opens, at most once a day, a notice says a new version is out. Nothing is installed without asking.",
     .es = "Al abrir NXDock, como mucho una vez al día, un aviso dice que hay una versión nueva. No se instala nada sin preguntar.",
     .fr = "À l'ouverture de NXDock, au plus une fois par jour, un avis dit qu'une nouvelle version est sortie. Rien n'est installé sans demander.",
     .de = "Beim Öffnen von NXDock, höchstens einmal am Tag, sagt ein Hinweis, dass eine neue Version da ist. Nichts wird ohne Frage installiert.",
     .it = "All'apertura di NXDock, al massimo una volta al giorno, un avviso dice che è uscita una nuova versione. Nulla si installa senza chiedere.",
     .pt = "Ao abrir o NXDock, no máximo uma vez por dia, um aviso diz que saiu uma versão nova. Nada é instalado sem perguntar.",
     .nl = "Bij het openen van NXDock, hoogstens eens per dag, zegt een melding dat er een nieuwe versie is. Er wordt niets geïnstalleerd zonder te vragen.",
     .ru = "При запуске NXDock, не чаще раза в день, уведомление говорит о новой версии. Ничего не устанавливается без вопроса.",
     .ja = "NXDock を開いたとき、多くても 1 日 1 回、新しいバージョンをお知らせします。確認なしには何もインストールしません。",
     .ko = "NXDock을 열 때 하루에 많아야 한 번 새 버전이 나왔다고 알려 줍니다. 묻지 않고는 아무것도 설치하지 않습니다.",
     .zh = "打开 NXDock 时，每天最多一次，提示有新版本。未经询问不会安装任何东西。")
TEXT(h_self_back,
     .en = "Puts back the copy kept from before the last update; the one you have is kept to come back to.",
     .es = "Vuelve a poner la copia guardada de antes de la última actualización; la que tienes se guarda para volver.",
     .fr = "Remet la copie gardée d'avant la dernière mise à jour ; celle que vous avez est gardée pour y revenir.",
     .de = "Setzt die Kopie von vor dem letzten Update wieder ein; die jetzige wird aufbewahrt, um zurückzukehren.",
     .it = "Rimette la copia tenuta da prima dell'ultimo aggiornamento; quella che hai si tiene per tornarci.",
     .pt = "Volta a pôr a cópia guardada de antes da última atualização; a que tem é guardada para voltar.",
     .nl = "Zet de kopie van voor de laatste update terug; de huidige wordt bewaard om naar terug te gaan.",
     .ru = "Возвращает копию, сохранённую перед последним обновлением; текущая сохраняется, чтобы к ней вернуться.",
     .ja = "前回の更新の前に残したコピーに戻します。今のものは戻れるように残します。",
     .ko = "마지막 업데이트 전에 남긴 사본으로 되돌립니다. 지금 버전은 돌아올 수 있게 남깁니다.",
     .zh = "换回上次更新前保留的副本；当前版本会保留，便于切换回来。")
TEXT(h_home,
     .en = "A shortcut with NXDock's icon on the HOME menu. From there NXDock has all the memory and downloads faster than from the Album. It needs sigpatches.",
     .es = "Un acceso directo con el icono de NXDock en el menú HOME. Desde ahí NXDock tiene toda la memoria y descarga más rápido que desde el Álbum. Necesita sigpatches.",
     .fr = "Un raccourci avec l'icône de NXDock dans le menu HOME. De là, NXDock a toute la mémoire et télécharge plus vite que depuis l'Album. Il faut des sigpatches.",
     .de = "Eine Verknüpfung mit dem Symbol von NXDock im HOME-Menü. Von dort hat NXDock den ganzen Speicher und lädt schneller als aus dem Album. Sie braucht Sigpatches.",
     .it = "Un collegamento con l'icona di NXDock nel menu HOME. Da lì NXDock ha tutta la memoria e scarica più veloce che dall'Album. Servono le sigpatch.",
     .pt = "Um atalho com o ícone do NXDock no menu HOME. Daí o NXDock tem toda a memória e descarrega mais depressa do que a partir do Álbum. Precisa de sigpatches.",
     .nl = "Een snelkoppeling met het pictogram van NXDock in het HOME-menu. Van daaruit heeft NXDock al het geheugen en downloadt het sneller dan vanuit het Album. Het heeft sigpatches nodig.",
     .ru = "Ярлык со значком NXDock в меню HOME. Оттуда у NXDock вся память и загрузка быстрее, чем из Альбома. Нужны sigpatches.",
     .ja = "NXDock のアイコンのショートカットを HOME メニューに置きます。そこから開くとメモリーをすべて使え、アルバムより速くダウンロードできます。sigpatches が必要です。",
     .ko = "NXDock 아이콘의 바로가기를 HOME 메뉴에 둡니다. 거기서 열면 메모리를 모두 쓰고 앨범보다 빨리 다운로드합니다. sigpatches가 필요합니다.",
     .zh = "在 HOME 菜单放一个带 NXDock 图标的快捷方式。从那里打开，NXDock 可以使用全部内存，下载比从相册打开更快。需要 sigpatches。")
TEXT(h_home_remove,
     .en = "Takes the shortcut off the HOME menu. NXDock stays on the SD card and still opens from the Album.",
     .es = "Quita el acceso directo del menú HOME. NXDock sigue en la tarjeta SD y se abre desde el Álbum.",
     .fr = "Retire le raccourci du menu HOME. NXDock reste sur la carte SD et s'ouvre toujours depuis l'Album.",
     .de = "Nimmt die Verknüpfung aus dem HOME-Menü. NXDock bleibt auf der SD-Karte und öffnet sich weiter aus dem Album.",
     .it = "Toglie il collegamento dal menu HOME. NXDock resta sulla scheda SD e si apre sempre dall'Album.",
     .pt = "Tira o atalho do menu HOME. O NXDock fica no cartão SD e continua a abrir a partir do Álbum.",
     .nl = "Haalt de snelkoppeling uit het HOME-menu. NXDock blijft op de SD-kaart en opent nog steeds vanuit het Album.",
     .ru = "Убирает ярлык из меню HOME. NXDock остаётся на SD-карте и по-прежнему открывается из Альбома.",
     .ja = "HOME メニューからショートカットを外します。NXDock は SD カードに残り、アルバムから開けます。",
     .ko = "HOME 메뉴에서 바로가기를 뺍니다. NXDock은 SD 카드에 남고 앨범에서 계속 열립니다.",
     .zh = "从 HOME 菜单移除快捷方式。NXDock 仍在 SD 卡上，仍可从相册打开。")

