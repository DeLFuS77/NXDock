TEXT(so_body,
     .en = "The screen turns off. The install goes on.\nPress any button or touch the screen to turn it on. It turns on by itself at the end.",
     .es = "La pantalla se apaga. La instalación sigue.\nPulsa cualquier botón o toca la pantalla para encenderla. Al terminar se enciende sola.",
     .fr = "L'écran s'éteint. L'installation continue.\nAppuie sur un bouton ou touche l'écran pour le rallumer. Il se rallume tout seul à la fin.",
     .de = "Der Bildschirm geht aus. Die Installation läuft weiter.\nDrücke eine Taste oder tippe auf den Bildschirm, um ihn einzuschalten. Am Ende geht er von selbst an.",
     .it = "Lo schermo si spegne. L'installazione continua.\nPremi un tasto o tocca lo schermo per riaccenderlo. Alla fine si riaccende da solo.",
     .pt = "A tela se apaga. A instalação continua.\nPressione um botão ou toque na tela para acendê-la. No fim ela acende sozinha.",
     .nl = "Het scherm gaat uit. De installatie gaat door.\nDruk op een knop of raak het scherm aan om het aan te zetten. Aan het eind gaat het vanzelf aan.",
     .ru = "Экран выключится. Установка продолжится.\nНажмите любую кнопку или коснитесь экрана, чтобы включить его. В конце он включится сам.",
     .ja = "画面を消します。インストールは続きます。\nボタンを押すか画面に触れると点きます。終わると自動で点きます。",
     .ko = "화면이 꺼집니다. 설치는 계속됩니다.\n아무 버튼이나 누르거나 화면을 터치하면 켜집니다. 끝나면 저절로 켜집니다.",
     .zh = "屏幕将关闭，安装继续进行。\n按任意按钮或触摸屏幕即可点亮。完成时会自动点亮。")
