TEXT(nand_q_body,
     .en = "Until you leave this screen, games dropped in \"Install to the internal memory\" are written to the memory of the console, which is small and also used by the system.",
     .es = "Hasta que salgas de esta pantalla, los juegos que sueltes en «Instalar en la memoria interna» se escriben en la memoria de la consola, que es pequeña y también la usa el sistema.",
     .fr = "Jusqu'à ce que tu quittes cet écran, les jeux déposés dans « Installer dans la mémoire interne » sont écrits dans la mémoire de la console, petite et utilisée aussi par le système.",
     .de = "Bis du diesen Bildschirm verlässt, werden Spiele in „In den internen Speicher installieren“ in den Speicher der Konsole geschrieben, der klein ist und auch vom System genutzt wird.",
     .it = "Finché non esci da questa schermata, i giochi lasciati in «Installa nella memoria interna» vengono scritti nella memoria della console, piccola e usata anche dal sistema.",
     .pt = "Até você sair desta tela, os jogos soltos em \"Instalar na memória interna\" são gravados na memória do console, que é pequena e também usada pelo sistema.",
     .nl = "Tot je dit scherm verlaat, worden spellen in \"Installeren in het interne geheugen\" naar het geheugen van de console geschreven, dat klein is en ook door het systeem wordt gebruikt.",
     .ru = "Пока вы не покинете этот экран, игры, брошенные в «Установить во внутреннюю память», записываются в память консоли, которая мала и используется системой.",
     .ja = "この画面を離れるまで、「本体保存メモリーにインストール」に置いたゲームは本体のメモリーに書き込まれます。容量が小さく、システムも使います。",
     .ko = "이 화면을 나갈 때까지 \"본체 저장 메모리에 설치\"에 놓은 게임은 본체 메모리에 기록됩니다. 용량이 작고 시스템도 사용합니다.",
     .zh = "在你离开此界面之前，放入“安装到主机内存”的游戏会写入主机内存；它容量小，系统也在使用。")
