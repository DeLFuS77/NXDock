TEXT(usb_steps,
     .en = "1. Connect the cable.\n2. In NS-USBloader choose the Tinfoil protocol.\n3. Add the games and press Upload.\n4. Or open dbibackend (of DBI) with the games: NXDock asks it for them.",
     .es = "1. Conecta el cable.\n2. En NS-USBloader elige el protocolo Tinfoil.\n3. Añade los juegos y pulsa Subir.\n4. O abre dbibackend (de DBI) con los juegos: NXDock se los pide.",
     .fr = "1. Branche le câble.\n2. Dans NS-USBloader choisis le protocole Tinfoil.\n3. Ajoute les jeux et appuie sur Upload.\n4. Ou ouvre dbibackend (de DBI) avec les jeux : NXDock les lui demande.",
     .de = "1. Schließe das Kabel an.\n2. Wähle in NS-USBloader das Tinfoil-Protokoll.\n3. Füge die Spiele hinzu und drücke Upload.\n4. Oder öffne dbibackend (von DBI) mit den Spielen: NXDock fragt sie dort ab.",
     .it = "1. Collega il cavo.\n2. In NS-USBloader scegli il protocollo Tinfoil.\n3. Aggiungi i giochi e premi Upload.\n4. Oppure apri dbibackend (di DBI) con i giochi: NXDock glieli chiede.",
     .pt = "1. Conecte o cabo.\n2. No NS-USBloader escolha o protocolo Tinfoil.\n3. Adicione os jogos e pressione Upload.\n4. Ou abra o dbibackend (do DBI) com os jogos: o NXDock pede-os.",
     .nl = "1. Sluit de kabel aan.\n2. Kies in NS-USBloader het Tinfoil-protocol.\n3. Voeg de spellen toe en druk op Upload.\n4. Of open dbibackend (van DBI) met de spellen: NXDock vraagt ze op.",
     .ru = "1. Подключите кабель.\n2. В NS-USBloader выберите протокол Tinfoil.\n3. Добавьте игры и нажмите Upload.\n4. Или откройте dbibackend (из DBI) с играми: NXDock сам их запросит.",
     .ja = "1. ケーブルをつなぐ。\n2. NS-USBloader で Tinfoil プロトコルを選ぶ。\n3. ゲームを追加して Upload を押す。\n4. または DBI の dbibackend でゲームを開く。NXDock が自動で受け取ります。",
     .ko = "1. 케이블을 연결하세요.\n2. NS-USBloader에서 Tinfoil 프로토콜을 고르세요.\n3. 게임을 추가하고 Upload를 누르세요.\n4. 또는 DBI의 dbibackend로 게임을 여세요. NXDock이 받아 옵니다.",
     .zh = "1. 连接数据线。\n2. 在 NS-USBloader 中选择 Tinfoil 协议。\n3. 添加游戏并按 Upload。\n4. 或用 DBI 的 dbibackend 打开游戏：NXDock 会自行获取。")
