TEXT(cz_sig_missing,
     .en = "No signature patches (sigpatches): a compressed game would not start. NXDock does not install them.",
     .es = "Sin parches de firma (sigpatches): un juego comprimido no arrancaría. NXDock no los instala.",
     .fr = "Pas de correctifs de signature (sigpatches) : un jeu compressé ne démarrerait pas. NXDock ne les installe pas.",
     .de = "Keine Signatur-Patches (Sigpatches): Ein komprimiertes Spiel würde nicht starten. NXDock installiert sie nicht.",
     .it = "Nessuna patch di firma (sigpatches): un gioco compresso non partirebbe. NXDock non le installa.",
     .pt = "Sem correções de assinatura (sigpatches): um jogo comprimido não arrancaria. O NXDock não as instala.",
     .nl = "Geen handtekeningpatches (sigpatches): een gecomprimeerd spel zou niet starten. NXDock installeert ze niet.",
     .ru = "Нет патчей подписи (sigpatches): сжатая игра не запустится. NXDock их не устанавливает.",
     .ja = "署名パッチ（sigpatches）がありません。圧縮したゲームは起動しません。NXDock はインストールしません。",
