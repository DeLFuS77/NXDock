TEXT(cz_keys_d,
     .en = "To open the key of a game's ticket, Compress games needs your prod.keys at sdmc:/switch/prod.keys (Lockpick_RCM writes it there). It is read only to compress, kept in memory, never shown or saved. Nothing was changed.",
     .es = "Para abrir la clave del ticket de un juego, Comprimir juegos necesita tu prod.keys en sdmc:/switch/prod.keys (Lockpick_RCM lo deja ahí). Solo se lee para comprimir, se queda en memoria y nunca se muestra ni se guarda. No se ha cambiado nada.",
     .fr = "Pour ouvrir la clé du ticket d'un jeu, Compresser les jeux a besoin de votre prod.keys dans sdmc:/switch/prod.keys (Lockpick_RCM l'y écrit). Il n'est lu que pour compresser, reste en mémoire et n'est jamais affiché ni enregistré. Rien n'a été modifié.",
     .de = "Um den Schlüssel des Tickets eines Spiels zu öffnen, braucht Spiele komprimieren deine prod.keys unter sdmc:/switch/prod.keys (Lockpick_RCM legt sie dort ab). Sie wird nur zum Komprimieren gelesen, bleibt im Speicher und wird nie angezeigt oder gespeichert. Es wurde nichts geändert.",
     .it = "Per aprire la chiave del ticket di un gioco, Comprimi giochi ha bisogno del tuo prod.keys in sdmc:/switch/prod.keys (Lockpick_RCM lo mette lì). Si legge solo per comprimere, resta in memoria e non viene mai mostrato né salvato. Non è stato cambiato nulla.",
     .pt = "Para abrir a chave do ticket de um jogo, Comprimir jogos precisa do teu prod.keys em sdmc:/switch/prod.keys (o Lockpick_RCM deixa-o lá). Só é lido para comprimir, fica em memória e nunca é mostrado nem guardado. Nada foi alterado.",
     .nl = "Om de sleutel van het ticket van een spel te openen, heeft Spellen comprimeren je prod.keys nodig in sdmc:/switch/prod.keys (Lockpick_RCM zet hem daar). Hij wordt alleen gelezen om te comprimeren, blijft in het geheugen en wordt nooit getoond of opgeslagen. Er is niets veranderd.",
     .ru = "Чтобы открыть ключ билета игры, функции «Сжать игры» нужен ваш prod.keys в sdmc:/switch/prod.keys (Lockpick_RCM кладёт его туда). Он читается только для сжатия, остаётся в памяти и никогда не показывается и не сохраняется. Ничего не изменено.",
     .ja = "ゲームのチケットの鍵を開くには、sdmc:/switch/prod.keys に prod.keys が必要です（Lockpick_RCM がそこに書き出します）。圧縮のためだけに読み込み、メモリ上にのみ保持し、表示も保存もしません。何も変更していません。",
     .ko = "게임 티켓의 키를 열려면 sdmc:/switch/prod.keys에 prod.keys가 있어야 합니다(Lockpick_RCM이 그곳에 저장합니다). 압축할 때만 읽고 메모리에만 두며, 표시하거나 저장하지 않습니다. 아무것도 바꾸지 않았습니다.",
     .zh = "要打开游戏票据的密钥，压缩游戏需要 sdmc:/switch/prod.keys 中的 prod.keys（Lockpick_RCM 会把它放在那里）。它只在压缩时读取，只保存在内存中，从不显示或保存。未做任何更改。")
