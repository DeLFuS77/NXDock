TEXT(cz_go_merge_body_fmt,
     .en = "The game and its update v%u become one and are compressed: it saves about %s. Before starting, what changes:",
     .es = "El juego y su actualización v%u pasan a ser uno solo y se comprimen: ahorra unos %s. Antes de empezar, lo que cambia:",
     .fr = "Le jeu et sa mise à jour v%u deviennent un seul et sont compressés : environ %s de gagnés. Avant de commencer, ce qui change :",
     .de = "Das Spiel und sein Update v%u werden eins und komprimiert: spart etwa %s. Vor dem Start, was sich ändert:",
     .it = "Il gioco e il suo aggiornamento v%u diventano uno solo e vengono compressi: risparmia circa %s. Prima di iniziare, cosa cambia:",
     .pt = "O jogo e a sua atualização v%u passam a ser um só e são comprimidos: poupa cerca de %s. Antes de começar, o que muda:",
     .nl = "Het spel en zijn update v%u worden één en worden gecomprimeerd: bespaart ongeveer %s. Voor je begint, wat er verandert:",
     .ru = "Игра и её обновление v%u станут одной и будут сжаты: экономия около %s. Перед началом — что изменится:",
     .ja = "ゲームと更新データ v%u をひとつにして圧縮します。約 %s 削減されます。始める前に、変わること：",
     .ko = "게임과 업데이트 v%u 가 하나가 되어 압축됩니다. 약 %s 절약됩니다. 시작하기 전에 바뀌는 점:",
     .zh = "游戏与其更新 v%u 将合为一个并压缩：约节省 %s。开始前，会有这些变化：")
TEXT(cz_merge_risks,
     .en = "• Official updates are no longer installed over it (the eShop will offer them; do not accept them). A newer update installed with NXDock is merged by itself when it ends.\n• “Undo” installs the original game and its update again from the library.",
     .es = "• Las actualizaciones oficiales ya no se instalan encima (la eShop las ofrecerá, pero no hay que aceptarlas). Una actualización nueva instalada con NXDock se junta sola al acabar.\n• «Deshacer» vuelve a instalar el juego y su actualización originales desde la biblioteca.",
     .fr = "• Les mises à jour officielles ne s’installent plus par-dessus (l’eShop les proposera ; ne les acceptez pas). Une nouvelle mise à jour installée avec NXDock est fusionnée toute seule à la fin.\n• « Annuler » réinstalle le jeu et sa mise à jour d’origine depuis la bibliothèque.",
     .de = "• Offizielle Updates werden nicht mehr darüber installiert (der eShop bietet sie an; nicht annehmen). Ein neueres Update, das mit NXDock installiert wird, wird am Ende von selbst zusammengeführt.\n• „Rückgängig“ installiert das originale Spiel und sein Update wieder aus der Bibliothek.",
     .it = "• Gli aggiornamenti ufficiali non si installano più sopra (l’eShop li proporrà; non accettarli). Un nuovo aggiornamento installato con NXDock viene unito da solo alla fine.\n• «Annulla» reinstalla il gioco e il suo aggiornamento originali dalla libreria.",
     .pt = "• As atualizações oficiais já não se instalam por cima (a eShop vai oferecê-las; não as aceites). Uma atualização nova instalada com o NXDock junta-se sozinha no fim.\n• «Desfazer» volta a instalar o jogo e a atualização originais a partir da biblioteca.",
     .nl = "• Officiële updates worden er niet meer overheen geïnstalleerd (de eShop biedt ze aan; accepteer ze niet). Een nieuwere update die met NXDock wordt geïnstalleerd, wordt aan het einde vanzelf samengevoegd.\n• ‘Ongedaan maken’ installeert het originele spel en zijn update opnieuw vanuit de bibliotheek.",
     .ru = "• Официальные обновления больше не устанавливаются поверх (eShop будет их предлагать — не принимайте). Новое обновление, установленное через NXDock, объединяется само в конце.\n• «Отменить» снова устанавливает исходную игру и её обновление из библиотеки.",
     .ja = "• 公式の更新データは上からインストールできなくなります（eShopに表示されても受け入れないでください）。NXDockでインストールした新しい更新データは、終わると自動でまとめられます。\n• 「元に戻す」で、元のゲームと更新データをライブラリから再インストールします。",
     .ko = "• 공식 업데이트는 더 이상 위에 설치되지 않습니다(eShop에서 제안해도 받지 마세요). NXDock으로 설치한 새 업데이트는 끝나면 자동으로 합쳐집니다.\n• '되돌리기'는 원래 게임과 업데이트를 라이브러리에서 다시 설치합니다.",
     .zh = "• 官方更新不能再安装在其上（eShop 会提示，请不要接受）。用 NXDock 安装的新更新会在结束后自动合并。\n• “撤销”会从游戏库重新安装原始游戏及其更新。")
