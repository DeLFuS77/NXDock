TEXT(cz_nosig_body,
     .en = "A compressed game is no longer signed by Nintendo, and the console only starts it with the patches of its file system (sigpatches). None were found on the SD card, so NXDock does not compress anything. NXDock never installs them.",
     .es = "Un juego comprimido ya no lleva la firma de Nintendo y la consola solo lo arranca con los parches de su sistema de archivos (sigpatches). No se han encontrado en la SD, así que NXDock no comprime nada. NXDock nunca los instala.",
     .fr = "Un jeu compressé n'est plus signé par Nintendo et la console ne le démarre qu'avec les patchs de son système de fichiers (sigpatches). Aucun n'a été trouvé sur la carte SD, donc NXDock ne compresse rien. NXDock ne les installe jamais.",
     .de = "Ein komprimiertes Spiel ist nicht mehr von Nintendo signiert, und die Konsole startet es nur mit den Patches ihres Dateisystems (Sigpatches). Auf der SD-Karte wurden keine gefunden, deshalb komprimiert NXDock nichts. NXDock installiert sie nie.",
     .it = "Un gioco compresso non ha più la firma di Nintendo e la console lo avvia solo con le patch del suo file system (sigpatch). Non ne sono stati trovati sulla scheda SD, quindi NXDock non comprime nulla. NXDock non li installa mai.",
     .pt = "Um jogo comprimido já não tem a assinatura da Nintendo e o console só o inicia com os patches do sistema de arquivos (sigpatches). Nenhum foi encontrado no cartão SD, então o NXDock não comprime nada. O NXDock nunca os instala.",
     .nl = "Een gecomprimeerd spel is niet meer door Nintendo ondertekend en de console start het alleen met de patches van zijn bestandssysteem (sigpatches). Er zijn er geen gevonden op de SD-kaart, dus NXDock comprimeert niets. NXDock installeert ze nooit.",
     .ru = "Сжатая игра больше не подписана Nintendo, и консоль запускает её только с патчами файловой системы (sigpatches). На SD-карте они не найдены, поэтому NXDock ничего не сжимает. NXDock никогда их не устанавливает.",
     .ja = "圧縮したゲームは Nintendo の署名がなくなり、本体はファイルシステムのパッチ（sigpatches）があるときだけ起動します。SD カードに見つからないため、NXDock は何も圧縮しません。NXDock は sigpatches をインストールしません。",
     .ko = "압축한 게임은 더 이상 닌텐도 서명이 없고, 본체는 파일 시스템 패치(sigpatches)가 있을 때만 실행합니다. SD 카드에서 찾지 못해 NXDock은 아무것도 압축하지 않습니다. NXDock은 sigpatches를 설치하지 않습니다.",
     .zh = "压缩后的游戏不再有任天堂签名，主机只有在装了文件系统补丁（sigpatches）时才会启动它。SD 卡上没有找到，所以 NXDock 不会压缩任何内容。NXDock 绝不会安装它们。")
